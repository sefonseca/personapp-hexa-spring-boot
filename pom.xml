<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>co.edu.javeriana.as</groupId>
	<artifactId>personapp-hexa-spring-boot</artifactId>
	<version>${revision}</version>
	<name>PersonAPP</name>
	<description>App Hexagonal (Clean Architecture) Multi Module PersonAPP</description>
	<packaging>pom</packaging>
	<properties>
		<maven.compiler.release>${global.java.version}</maven.compiler.release>
		<java.version>${global.java.version}</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<revision>0.0.1-SNAPSHOT</revision>
		<!-- Versiones LTS / estables vigentes -->
		<global.java.version>25</global.java.version>
		<global.springframework.boot.version>4.1.2</global.springframework.boot.version>
		<global.lombok.version>1.18.48</global.lombok.version>
		<global.springdoc.version>3.2.0</global.springdoc.version>
		<global.maven.compiler.version>3.16.0</global.maven.compiler.version>
	</properties>
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>Andres Sanchez</name>
			<email>asanchez-m@javeriana.edu.co</email>
			<organization>Pontificia Universidad Javeriana</organization>
			<organizationUrl>https://www.javeriana.edu.co</organizationUrl>
		</developer>
	</developers>
	<modules>
		<module>common</module>
		<module>domain</module>
		<module>application</module>
		<module>maria-output-adapter</module>
		<module>mongo-output-adapter</module>
		<module>rest-input-adapter</module>
		<module>cli-input-adapter</module>
	</modules>
	<!-- El BOM de Spring Boot fija versiones compatibles entre si para todas las
	     dependencias (Spring Framework, Hibernate, drivers, Jackson, etc.) -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${global.springframework.boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${global.lombok.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
	</dependencies>
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<version>${global.springframework.boot.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- Desde JDK 23 los procesadores de anotaciones no se ejecutan
			     automaticamente: se declara Lombok de forma explicita -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${global.maven.compiler.version}</version>
				<configuration>
					<release>${global.java.version}</release>
					<!-- Spring 6.1+ ya no deduce nombres de parametros sin -parameters
					     (lo hacia el spring-boot-starter-parent, que este proyecto no usa) -->
					<parameters>true</parameters>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${global.lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
